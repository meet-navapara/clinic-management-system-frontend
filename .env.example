# Dev server port
VITE_DEV_PORT=3000

# Leave empty in local/prod behind a reverse proxy so the app uses same-origin `/api`
# (Vite proxies /api → backend). Required for httpOnly auth cookies.
# Cross-origin only: set to e.g. http://localhost:5000
VITE_BACKEND_URL=

# API base path for axios
VITE_API_BASE_URL=/api
